{
  "name": "nuaai",
  "version": "0.1.0",
  "description": "NUAAI — not ur avg ai",
  "type": "module",
  "bin": {
    "nuaai": "./dist/cli.js"
  },
  "files": ["dist", "scripts", "deploy", "docs", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/tylerdotai/nuaai.git"
  },
  "bugs": {
    "url": "https://github.com/tylerdotai/nuaai/issues"
  },
  "homepage": "https://github.com/tylerdotai/nuaai#readme",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "dev:server": "tsx src/server.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "tsup src/cli.tsx src/server.ts src/daemon.ts --format esm --clean --out-dir dist",
    "build:web": "vite build --config src/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src tests scripts .config *.json *.ts",
    "lint": "biome lint src tests scripts .config",
    "check": "biome check src tests scripts .config && npm run typecheck",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:coverage": "vitest run --coverage",
    "version:check": "node scripts/check-version.mjs",
    "gate": "npm run version:check && npm run check && npm test && npm run build && npm run build:web"
  },
  "keywords": [
    "ai-agent",
    "agent-harness",
    "developer-tools",
    "local-first",
    "model-agnostic",
    "nuaai",
    "not-ur-avg-ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "execa": "10.0.1",
    "fast-glob": "3.3.3",
    "hono": "4.13.2",
    "ink": "7.1.1",
    "pathe": "2.0.3",
    "picocolors": "1.1.1",
    "react": "19.2.8",
    "react-dom": "^19.2.8",
    "sqlite-vec": "0.1.9",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "ts-morph": "28.0.0",
    "tsup": "8.5.1",
    "tsx": "^4.23.12",
    "typescript": "5.7.2",
    "vite": "^6.4.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.23.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.2"
    }
  }
}
